// Signing. Put your own team in Config/Local.xcconfig (git-ignored):
//   DEVELOPMENT_TEAM = ABCDE12345
// Builds and archives sign with Apple Development; scripts/release.sh exports the archive
// with a Developer ID certificate and notarizes it through your Xcode account.
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = Apple Development
OTHER_CODE_SIGN_FLAGS = --timestamp

#include? "Local.xcconfig"
